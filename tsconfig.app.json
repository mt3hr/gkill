{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/client/**/*", "src/client/**/*.vue", "public/sw.js"],
  "exclude": ["src/**/__tests__/**"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    // ServiceWorker (public/sw.js / src/client/serviceWorker.ts) が使う API
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
    // 地図ビューが使う Google Maps と、PWA プラグインが注入する仮想モジュールの型。
    // 以前はルートの tsconfig.json に書いてあったが "files": [] のせいで効いておらず、
    // しかも "vite-pluginb-pwa/client" と綴りを間違えていた
    "types": ["google.maps", "vite-plugin-pwa/client"],

    "paths": {
      "@/*": ["./src/client/*"]
    }
  }
}
