<?xml version="1.0" encoding="utf-8"?>
<!--
  平文(HTTP)通信の許可範囲を絞る設定。

  同梱の gkill_server の待受アドレスと TLS は ServerConfig に従い（既定は TLS 無効の平文）、
  WebView が読むのはサーバが知らせる localhost の URL（http / https、ポートは設定次第）だけ。
  よって既定では平文を全面禁止し、localhost / 127.0.0.1 のドメインに限って許可する（ポートは問わない）。
  外部ホストへの平文接続は不可になるので、以前の usesCleartextTraffic="true" と違い
  意図しない平文送信を防げる。TLS 有効時の自己署名証明書は MainActivity の
  onReceivedSslError がループバックに限って通す。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
