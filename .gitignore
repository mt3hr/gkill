.DS_Store
/node_modules
/dist
/release/*
/**/embed/**/*
# embed配下は生成物だが、1件も無いと //go:embed がコンパイルエラーになるため
# プレースホルダだけ追跡する (詳細は PLACEHOLDER.md)
!/src/server/gkill/api/embed/PLACEHOLDER.md
/**/assets/*
# src/client/assets/ はビルド生成物ではなくソース(コンポーネントがimportする画像)なので追跡する
!/src/client/assets/*
/**/jniLibs/**/*.so
/**/*.exe

~$*
*.asta.lock
m_plus.conf

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.DS_Store
dist
dist-ssr
coverage
*.local

/cypress/videos/
/cypress/screenshots/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*.tsbuildinfo

# .claude 直下は無視するが、リポジトリで共有する規約スキルだけ追跡する。
# （/.claude のままではネガティブパターンが効かない。skills を追跡しないと CI に存在せず、
#   verify_docs の checkSkills が「1つも見つからない」で落ちる。settings.local.json は無視のまま）
/.claude/*
!/.claude/skills/
# 個人情報検査のローカル NG 語リスト（コミットしない。checkPersonalInfo が読む）
/verify_docs_personal_ngwords.local.txt

# Wear OS (Gradle project)
src/wear_os/.gradle/
src/wear_os/.idea/
src/wear_os/**/*.iml
src/wear_os/**/build/
src/wear_os/local.properties
src/wear_os/phone_companion/src/main/res/raw/wearable_app.apk

test-results
playwright-report
src/client/__tests__/e2e/.auth/

# 生成されたManual
resources/manual/*

# Windowsのアイコン埋め込み用リソース。
# rsrc が build_windows_amd64 / build_windows_amd64_app の中で生成し、
# ビルド後に消す一時ファイル。中断すると残る
*.syso

# Git Bash のクラッシュダンプ（作業と無関係な事故ファイル）
*.stackdump

# 手元検証で作られる SQLite の残骸
user_config_test.db
