# gradlew は Linux/WSL から直接実行するため LF 固定。
# CRLF で checkout されるとビルドスクリプト側が毎回 LF へ書き換えて作業ツリーが汚れる。
src/android/gradlew text eol=lf
src/wear_os/gradlew text eol=lf
*.bat text eol=crlf

# マニュアル（生成物）・原稿フラグメント・docs ツールは LF 固定。
# 生成鮮度チェック（verify_docs）が Windows/Linux で一致するようにするため。
resources/manual/** text eol=lf
resources/manual_src/** text eol=lf
src/tools/*.mjs text eol=lf
